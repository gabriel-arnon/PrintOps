def is_ip_alive(ip):

    try:

        system = platform.system().lower()

        if system == "windows":

            command = [
                "ping",
                "-n",
                "1",
                "-w",
                "300",
                ip
            ]

        else:

            command = [
                "ping",
                "-c",
                "1",
                "-W",
                "1",
                ip
            ]

        result = subprocess.run(

            command,

            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,

            timeout=2

        )

        return result.returncode == 0

    except Exception:

        return False


